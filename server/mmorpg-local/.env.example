# Скопируй в .env и поменяй при необходимости (например, если порт занят)
PG_SUPER_USER=postgres
PG_SUPER_PASSWORD=postgres
PG_PORT=5432
REDIS_PORT=6379
# профиль full
SCYLLA_PORT=9042
KAFKA_PORT=9092
CH_HTTP_PORT=8123
CH_NATIVE_PORT=9000
BOT_TOKEN=
# 0 — вход только через Telegram (продакшен/Azure), 1 — разрешён dev-вход по имени
DEV_AUTH=1
API_PORT=8080
ADMIN_PASSWORD=admin
# Telegram-админы (через запятую): числовой tg-id или @username.
# Вход в /admin из Telegram без пароля (нужен ещё BOT_TOKEN выше).
ADMIN_TELEGRAM_IDS=
